{
  "expo": {
    "name": "Toqué",
    "slug": "toque-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "toqueapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#826A56",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pierrekasala.toque",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#826A56",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 202
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Toqué utilise l’appareil photo pour photographier tes plats.",
          "photosPermission": "Toqué accède à tes photos pour illustrer tes recettes."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/notification/timer.wav",
            "./assets/sounds/notification/den_den.wav",
            "./assets/sounds/notification/ultra_instinct.wav",
            "./assets/sounds/notification/outro.wav"
          ]
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*"
          ],
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ShareExtension",
                  "bundleIdentifier": "undefined.share-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.undefined"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "5a44f252-c0cb-4c68-b7ee-391c9f948be9"
      }
    },
    "owner": "follecourgette"
  }
}
