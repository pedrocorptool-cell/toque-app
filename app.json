{
  "expo": {
    "name": "Toqué",
    "slug": "toque-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "toqueapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#826A56",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pierrekasala.toque"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#826A56",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 202
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Toqué utilise l’appareil photo pour photographier tes plats.",
          "photosPermission": "Toqué accède à tes photos pour illustrer tes recettes."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/notification/timer.wav",
            "./assets/sounds/notification/den-den.wav",
            "./assets/sounds/notification/ultra-instinct.wav",
            "./assets/sounds/notification/outro.wav"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
